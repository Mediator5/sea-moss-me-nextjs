# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in what you have.
# The site runs fine without any of it — checkout simply tells the customer to
# order by email until STRIPE_SECRET_KEY is set.
# ---------------------------------------------------------------------------

# Public URL of the live site (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://seamossme.com

# Stripe — dashboard.stripe.com/apikeys
# Use the test key (sk_test_...) until you're ready to take real money.
STRIPE_SECRET_KEY=

# Email (optional) — resend.com. Without these, contact-form submissions and
# newsletter signups are written to the server log instead of being emailed.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
CONTACT_EMAIL=info@seamossme.com
CONTACT_FROM=Sea Moss Me <onboarding@resend.dev>
