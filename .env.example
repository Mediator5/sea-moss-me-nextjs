# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the blanks.
#
#   cp .env.example .env.local
#
# The site runs without any of it — forms just write to the server log instead
# of emailing — so you can set these up whenever you're ready.
# ---------------------------------------------------------------------------


# --- Site ------------------------------------------------------------------
# Used for canonical URLs, the sitemap and social share tags.
NEXT_PUBLIC_SITE_URL=https://seamossme.com


# --- Checkout mode ---------------------------------------------------------
# "request" = the cart hands off to the order request form at /checkout, and
#             the order arrives by email. No payment is taken. (current setup)
# "stripe"  = the cart creates a Stripe Checkout session instead, and takes
#             card payment. Needs STRIPE_SECRET_KEY below.
NEXT_PUBLIC_CHECKOUT_MODE=request


# --- Email: Nodemailer over Google -----------------------------------------
# Works with a personal Gmail account or Google Workspace.
#
# SETUP, once:
#   1. Turn on 2-Step Verification for the Google account that will send:
#      https://myaccount.google.com/security
#   2. Create an App Password (2-Step Verification -> App passwords).
#      Google shows you 16 characters like "abcd efgh ijkl mnop".
#   3. Paste those 16 characters into SMTP_PASS below — spaces are fine.
#      This is NOT your normal Google password, and you can revoke it any time.
#
# Note: App Passwords only exist on accounts with 2-Step Verification on. If
# you don't see the option, 2-Step Verification isn't enabled yet.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# The Google account doing the sending.
SMTP_USER=
SMTP_PASS=

# Who receives order requests, contact messages and newsletter signups.
MAIL_TO=info@seamossme.com

# What customers see in the From line. Gmail requires this address to be the
# SMTP_USER account, or an alias it is allowed to "send mail as".
MAIL_FROM=Sea Moss Me <info@seamossme.com>

# Optional: silently copy every message to a second inbox.
MAIL_BCC=


# --- Stripe (optional, for later) ------------------------------------------
# Only used when NEXT_PUBLIC_CHECKOUT_MODE=stripe.
# Get the key at https://dashboard.stripe.com/apikeys — start with the test
# key (sk_test_...) before going live.
STRIPE_SECRET_KEY=
